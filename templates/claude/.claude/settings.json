{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(jj status*)",
      "Bash(jj log*)",
      "Bash(jj diff*)",
      "Bash(jj show*)",
      "{if:justfile}Bash(just*)",
      "{if:flake}Bash(nix flake check*)",
      "{if:flake}Bash(nix eval*)",
      "{if:flake}Bash(nix build --dry-run*)",
      "{if:flake}Bash(nix search nixpkgs*)",
      "{if:flake}Bash(statix check*)",
      "{if:flake}Bash(deadnix*)",
      "{if:flake}Bash(nixfmt*)",
      "{if:rust}Bash(cargo check*)",
      "{if:rust}Bash(cargo fmt*)",
      "{if:rust}Bash(cargo nextest run*)",
      "{if:rust}Bash(cargo test*)",
      "{if:rust}Bash(cargo tree*)",
      "{if:clippy}Bash(cargo clippy*)",
      "{if:machete}Bash(cargo machete*)",
      "{if:deny}Bash(cargo deny check*)",
      "{if:audit}Bash(cargo audit*)",
      "{if:taplo}Bash(taplo*)",
      "{if:typos}Bash(typos*)",
      "{if:committed}Bash(committed*)",
      "{if:cliff}Bash(git cliff*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(jj git push*)",
      "Bash(git commit*)",
      "Bash(jj commit*)",
      "Bash(jj describe*)",
      "Bash(git tag*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(jj rebase*)",
      "Bash(jj abandon*)",
      "Bash(jj bookmark*)",
      "Bash(gh pr create*)",
      "Bash(gh release*)",
      "{if:rust}Bash(cargo publish*)",
      "{if:justfile}Bash(just publish*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "{if:envrc}Read(./.direnv/**)"
    ]
  }
}
