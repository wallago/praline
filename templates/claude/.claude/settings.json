{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      // {slot:claude.permissions}
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
