# configuration for https://editorconfig.org

root = true
# {if:rust}

[*.rs]
indent_style = space
indent_size = 4

[args.rs]
indent_size = unset
# {endif:rust}

[*.yml]
indent_style = space
indent_size = 2
# {if:web}

[*.{ts,tsx,js,json,css,html,svg}]
indent_style = space
indent_size = 2
# {endif:web}
