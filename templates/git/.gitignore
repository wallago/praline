# {if:rust}
# ── Rust / Cargo ─────────────────────────────────────────────
# Compiled files, executables, and build artifacts
debug/
target/

# Backup files generated by rustfmt
**/*.rs.bk

# Debug info from MSVC Windows builds of rustc
*.pdb

# Mutation testing data from cargo-mutants
**/mutants.out*/

# NOTE: Cargo.lock is committed on purpose
# {if:codecov}

# Coverage report from `just coverage`
lcov.info
# {endif:codecov}

# {endif:rust}
# {if:web}
# ── Web / pnpm ───────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# NOTE: pnpm-lock.yaml is committed on purpose
# {endif:web}
# {if:flake}
# ── Nix ──────────────────────────────────────────────────────
# Build result symlinks (result, result-bin, result-1, …)
/result
/result-*

# ── Local development environment ────────────────────────────
.direnv/
# {endif:flake}
