let cans = config
    .can
    .iter()
    .map(|can_config| can::Can::new(&can_config.bus, Some(&can_config.target_frames_id)))
    .collect::<Result<Vec<_>>>()?;
let can = if let Some(can) = cans.first()
    && config.can.len() == 1
{
    can
} else {
    return Err(Error::Config("expecting exactly one CAN setup".to_string()));
};
// Frames read from the bus go out on `can_rx`; frames sent on `can_tx` are
// written to it. Clone `can_rx` to subscribe, or `_can_tx` to write; the
// underscored bindings keep both channels open.
let (can_rx, _can_rx_keep) = tokio::sync::broadcast::channel::<can::CanMessage>(100);
let (_can_tx, can_tx_source) = tokio::sync::broadcast::channel::<can::CanMessage>(100);
