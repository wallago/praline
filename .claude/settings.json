{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "manual",
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(jj status*)",
      "Bash(jj log*)",
      "Bash(jj diff*)",
      "Bash(jj show*)",
      "Bash(just*)",
      "Bash(nix flake check*)",
      "Bash(nix eval*)",
      "Bash(nix build --dry-run*)",
      "Bash(nixos-rebuild dry-build*)",
      "Bash(nix search nixpkgs*)",
      "Bash(curl -s https://search.nixos.org*)",
      "Bash(statix check*)",
      "Bash(deadnix*)",
      "Bash(nixfmt*)",
      "Bash(cargo check*)",
      "Bash(cargo fmt*)",
      "Bash(cargo nextest run*)",
      "Bash(cargo test*)",
      "Bash(cargo tree*)",
      "Bash(cargo clippy*)",
      "Bash(cargo machete*)",
      "Bash(cargo deny check*)",
      "Bash(cargo audit*)",
      "Bash(taplo*)",
      "Bash(typos*)",
      "Bash(committed*)",
      "Bash(git cliff*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(jj git push*)",
      "Bash(git commit*)",
      "Bash(jj commit*)",
      "Bash(jj describe*)",
      "Bash(git tag*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(jj rebase*)",
      "Bash(jj abandon*)",
      "Bash(jj bookmark*)",
      "Bash(gh pr create*)",
      "Bash(gh release*)",
      "Bash(cargo publish*)",
      "Bash(just publish*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "Read(./.direnv/**)"
    ]
  }
}
